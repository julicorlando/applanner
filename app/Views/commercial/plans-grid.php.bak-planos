<div class="sales-pricing-grid count-<?=min(4,count($plans))?>"><?php foreach($plans as $plan):$features=json_decode($plan['features_json']??'{}',true)?:[];$trial=(int)($plan['trial_days']??0);$commercial=array_values(array_filter((array)($features['included_features']??[]),'is_string'));?><article class="sales-price-card <?=$plan['featured']?'featured':''?>"><?php if($plan['featured']):?><div class="popular-ribbon">MAIS ESCOLHIDO</div><?php endif;?><div class="price-card-head"><span class="plan-for"><?=$plan['featured']?'Para negócios em crescimento':'Plano flexível'?></span><h3><?=htmlspecialchars($plan['name'],ENT_QUOTES,'UTF-8')?></h3><p><?=htmlspecialchars($plan['description']??'Para organizar sua rotina e crescer com controle.',ENT_QUOTES,'UTF-8')?></p></div><div class="price-line"><small>R$</small><strong><?=number_format((float)$plan['monthly_price'],2,',','.')?></strong><span>/mês</span></div><?php if($trial>0):?><div class="trial-highlight">Teste grátis por <?=$trial?> dias</div><?php endif;?><a class="btn <?=$plan['featured']?'btn-primary':'btn-outline-primary'?> btn-lg w-100" href="/cadastro?plan=<?=(int)$plan['id']?>"><?=$trial>0?'Começar teste grátis':'Escolher este plano'?></a><div class="plan-capacity"><span><b><?=(int)($features['professionals']??1)?></b> profissional(is)</span><span><b><?=(int)($features['units']??1)?></b> unidade(s)</span></div><div class="included-label">O que está incluído:</div><ul class="sales-feature-list"><?php if($commercial):?><?php foreach($commercial as $item):?><li><?=htmlspecialchars($item,ENT_QUOTES,'UTF-8')?></li><?php endforeach;?><?php else:?><li>Agenda, clientes e serviços</li><li>Link público de agendamento</li><?php foreach($plan['modules']??[] as $m):?><li><?=htmlspecialchars($m['name'],ENT_QUOTES,'UTF-8')?></li><?php endforeach;?><?php endif;?></ul><small class="price-footnote">Recursos e limites conforme a configuração do plano.</small></article><?php endforeach;?></div>
