<?php
namespace App\Controllers;
use App\Core\{Auth,Audit,CSRF,Database,HttpException,View};

final class CommercialTeamController
{
    private function commercial():array{Auth::requireRole('commercial');return Auth::user();}
    public function index():void
    {
        $user=$this->commercial();$pdo=Database::connection();$id=(int)$user['id'];$profile=$pdo->prepare('SELECT * FROM commercial_profiles WHERE user_id=:u');$profile->execute(['u'=>$id]);$profile=$profile->fetch();if(!$profile)HttpException::abort(403,'Perfil comercial não configurado pelo Master.');$ref=$pdo->prepare('SELECT referral_code FROM marketing_referral_profiles WHERE user_id=:u AND active=1');$ref->execute(['u'=>$id]);$code=$ref->fetchColumn();$plans=$pdo->query('SELECT id,name,description,monthly_price,trial_days FROM plans WHERE active=1 ORDER BY sort_order,monthly_price')->fetchAll();$stats=$pdo->prepare("SELECT COUNT(*) indications,SUM(status IN('approved','paid')) paid_customers,COALESCE(SUM(IF(status='projected',commission_amount,0)),0) projected,COALESCE(SUM(IF(status IN('approved','paid'),commission_amount,0)),0) approved FROM commercial_commissions WHERE commercial_user_id=:u");$stats->execute(['u'=>$id]);$stats=$stats->fetch();$commissions=$pdo->prepare('SELECT cc.*,t.name tenant_name FROM commercial_commissions cc JOIN tenants t ON t.id=cc.tenant_id WHERE cc.commercial_user_id=:u ORDER BY cc.id DESC LIMIT 100');$commissions->execute(['u'=>$id]);$proposals=$pdo->prepare('SELECT cp.*,p.name plan_name FROM commercial_proposals cp JOIN plans p ON p.id=cp.plan_id WHERE cp.commercial_user_id=:u ORDER BY cp.id DESC LIMIT 100');$proposals->execute(['u'=>$id]);$app=require __DIR__.'/../../config/app.php';View::render('commercial-team/index',['title'=>'Painel comercial','profile'=>$profile,'plans'=>$plans,'stats'=>$stats,'commissions'=>$commissions->fetchAll(),'proposals'=>$proposals->fetchAll(),'referralUrl'=>rtrim($app['url'],'/').'/indicacao/'.$code]);
    }
    public function proposal():void
    {
        $user=$this->commercial();CSRF::enforce();$pdo=Database::connection();$q=$pdo->prepare('SELECT max_discount_percent FROM commercial_profiles WHERE user_id=:u AND active=1');$q->execute(['u'=>$user['id']]);$max=(float)$q->fetchColumn();$planId=(int)($_POST['plan_id']??0);$discount=(float)str_replace(',','.',(string)($_POST['discount_percent']??0));if($discount<0||$discount>$max)HttpException::abort(422,'O desconto supera o limite autorizado pelo Master.');$q=$pdo->prepare('SELECT id,name,monthly_price FROM plans WHERE id=:id AND active=1');$q->execute(['id'=>$planId]);$plan=$q->fetch();if(!$plan)HttpException::abort(422,'Plano indisponível.');$title=trim((string)($_POST['title']??''));if(mb_strlen($title)<3)HttpException::abort(422,'Informe o nome da proposta.');$price=round((float)$plan['monthly_price']*(1-$discount/100),2);$token=bin2hex(random_bytes(16));$pdo->prepare("INSERT INTO commercial_proposals(commercial_user_id,plan_id,title,customer_name,customer_email,discount_percent,final_price,notes,public_token,status,expires_at,created_at,updated_at)VALUES(:u,:p,:title,:name,:email,:discount,:price,:notes,:token,'sent',DATE_ADD(NOW(),INTERVAL 30 DAY),NOW(),NOW())")->execute(['u'=>$user['id'],'p'=>$planId,'title'=>$title,'name'=>trim((string)($_POST['customer_name']??''))?:null,'email'=>mb_strtolower(trim((string)($_POST['customer_email']??'')))?:null,'discount'=>$discount,'price'=>$price,'notes'=>trim((string)($_POST['notes']??''))?:null,'token'=>$token]);Audit::log('COMMERCIAL_PROPOSAL_CREATED','commercial_proposals',(int)$pdo->lastInsertId(),null,['discount'=>$discount]);header('Location: /comercial?proposta=ok');exit;
    }
    public function publicProposal(string $token):void
    {
        if(!preg_match('/^[a-f0-9]{32}$/',$token))HttpException::abort(404,'Proposta inválida.');$pdo=Database::connection();$q=$pdo->prepare("SELECT cp.*,p.name plan_name,p.description,u.name commercial_name,rp.referral_code FROM commercial_proposals cp JOIN plans p ON p.id=cp.plan_id JOIN users u ON u.id=cp.commercial_user_id JOIN marketing_referral_profiles rp ON rp.user_id=u.id AND rp.active=1 WHERE cp.public_token=:t AND cp.status NOT IN('expired','cancelled') AND (cp.expires_at IS NULL OR cp.expires_at>NOW())");$q->execute(['t'=>$token]);$proposal=$q->fetch();if(!$proposal)HttpException::abort(404,'Proposta indisponível.');$pdo->prepare("UPDATE commercial_proposals SET status=IF(status='sent','viewed',status),updated_at=NOW() WHERE id=:id")->execute(['id'=>$proposal['id']]);View::render('commercial-team/proposal',['title'=>'Proposta ApPlanner','proposal'=>$proposal,'publicLayout'=>true]);
    }
}
