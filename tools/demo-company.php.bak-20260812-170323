            'public_enabled'=>1,'public_booking_enabled'=>1,'onboarding_step'=>9,
            'accepted_payment_methods'=>json_encode(['Pix','Cartão de crédito','Cartão de débito','Dinheiro'],JSON_UNESCAPED_UNICODE),
