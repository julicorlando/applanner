<?php
namespace App\Controllers;

use App\Core\{Authorization,CSRF,Database,TenantContext,View,Audit,HttpException,Auth};
use App\Services\ModuleService;

final class FinanceController
{
    private function enabled():void{ModuleService::require('finance');}
    public function index():void
    {
        $this->enabled();Authorization::require('finance.view');$t=TenantContext::id();$pdo=Database::connection();$status=(string)($_GET['status']??'');$type=(string)($_GET['type']??'');$where=['tenant_id=:t'];$p=['t'=>$t];if(in_array($status,['pending','paid','cancelled'],true)){$where[]='status=:status';$p['status']=$status;}if(in_array($type,['income','expense'],true)){$where[]='type=:type';$p['type']=$type;}$q=$pdo->prepare('SELECT ft.*,fc.name category_name FROM financial_transactions ft LEFT JOIN financial_categories fc ON fc.id=ft.category_id AND fc.tenant_id=ft.tenant_id WHERE '.implode(' AND ',$where).' ORDER BY COALESCE(ft.due_at,DATE(ft.created_at)) DESC,ft.id DESC LIMIT 400');$q->execute($p);$items=$q->fetchAll();$q=$pdo->prepare('SELECT * FROM financial_categories WHERE tenant_id=:t AND active=1 ORDER BY name');$q->execute(['t'=>$t]);$categories=$q->fetchAll();
        $q=$pdo->prepare("SELECT type,status,COALESCE(SUM(amount),0) total FROM financial_transactions WHERE tenant_id=:t AND DATE(COALESCE(competence_at,created_at)) BETWEEN DATE_FORMAT(CURDATE(),'%Y-%m-01') AND LAST_DAY(CURDATE()) GROUP BY type,status");$q->execute(['t'=>$t]);$summary=['income_paid'=>0,'income_pending'=>0,'expense_paid'=>0,'expense_pending'=>0];foreach($q->fetchAll() as $r)$summary[$r['type'].'_'.$r['status']]=(float)$r['total'];$summary['result']=$summary['income_paid']-$summary['expense_paid'];
        $q=$pdo->prepare("SELECT * FROM cash_sessions WHERE tenant_id=:t AND status='open' ORDER BY id DESC LIMIT 1");$q->execute(['t'=>$t]);$cash=$q->fetch()?:null;View::render('finance/index',['title'=>'Financeiro','items'=>$items,'categories'=>$categories,'summary'=>$summary,'cash'=>$cash,'status'=>$status,'type'=>$type]);
    }
    public function store():void
    {
        $this->enabled();Authorization::require('finance.manage');CSRF::enforce();$t=TenantContext::id();$type=(string)($_POST['type']??'');$description=trim((string)($_POST['description']??''));$amount=$this->money($_POST['amount']??null);$due=$this->date($_POST['due_at']??null);$category=(int)($_POST['category_id']??0)?:null;$method=(string)($_POST['payment_method']??'outro');$status=(string)($_POST['status']??'pending');$key=(string)($_POST['idempotency_key']??'');if(!in_array($type,['income','expense'],true)||$description===''||$amount===null||!preg_match('/^[a-f0-9]{32}$/',$key)||!in_array($status,['pending','paid'],true))HttpException::abort(422,'Dados financeiros inválidos.');if(!in_array($method,['pix','dinheiro','credito','debito','boleto','transferencia','outro'],true))$method='outro';if($category){$q=Database::connection()->prepare('SELECT 1 FROM financial_categories WHERE id=:id AND tenant_id=:t AND active=1');$q->execute(['id'=>$category,'t'=>$t]);if(!$q->fetchColumn())HttpException::abort(422,'Categoria inválida.');}
        $pdo=Database::connection();$q=$pdo->prepare("INSERT IGNORE INTO financial_transactions(tenant_id,category_id,type,description,amount,payment_method,status,idempotency_key,due_at,competence_at,paid_at,created_at,updated_at)VALUES(:t,:cat,:type,:d,:amount,:method,:status,:key,:due,COALESCE(:due2,CURDATE()),IF(:status2='paid',NOW(),NULL),NOW(),NOW())");$q->execute(['t'=>$t,'cat'=>$category,'type'=>$type,'d'=>$description,'amount'=>$amount,'method'=>$method,'status'=>$status,'key'=>$key,'due'=>$due,'due2'=>$due,'status2'=>$status]);Audit::log('finance.create','financial_transactions',(int)$pdo->lastInsertId());header('Location: /finance');exit;
    }
    public function markPaid(string $id):void{$this->enabled();Authorization::require('finance.manage');CSRF::enforce();$t=TenantContext::id();$pdo=Database::connection();$pdo->beginTransaction();try{$q=$pdo->prepare("SELECT * FROM financial_transactions WHERE id=:id AND tenant_id=:t AND status='pending' FOR UPDATE");$q->execute(['id'=>(int)$id,'t'=>$t]);$ft=$q->fetch();if(!$ft)throw new \DomainException('Lançamento não encontrado ou já processado.');$pdo->prepare("UPDATE financial_transactions SET status='paid',paid_at=NOW(),updated_at=NOW() WHERE id=:id AND tenant_id=:t")->execute(['id'=>(int)$id,'t'=>$t]);if(($ft['source_type']??'')==='membership'&&!empty($ft['source_id']))$this->grantMembershipCycle($pdo,$t,(int)$ft['source_id'],(int)$ft['id'],(float)$ft['amount']);$pdo->commit();}catch(\Throwable $e){if($pdo->inTransaction())$pdo->rollBack();HttpException::abort($e instanceof \DomainException?404:422,$e->getMessage());}Audit::log('finance.paid','financial_transactions',(int)$id);header('Location: /finance');exit;}
    public function cancel(string $id):void{$this->enabled();Authorization::require('finance.manage');CSRF::enforce();$t=TenantContext::id();$q=Database::connection()->prepare("UPDATE financial_transactions SET status='cancelled',updated_at=NOW() WHERE id=:id AND tenant_id=:t AND status<>'cancelled'");$q->execute(['id'=>(int)$id,'t'=>$t]);if(!$q->rowCount())HttpException::abort(404,'Lançamento não encontrado.');Audit::log('finance.cancel','financial_transactions',(int)$id);header('Location: /finance');exit;}
    public function addCategory():void{$this->enabled();Authorization::require('finance.categories.manage');CSRF::enforce();$t=TenantContext::id();$name=trim((string)($_POST['name']??''));$type=(string)($_POST['category_type']??'both');if(strlen($name)<2||!in_array($type,['income','expense','both'],true))HttpException::abort(422,'Categoria inválida.');Database::connection()->prepare('INSERT INTO financial_categories(tenant_id,name,type,active,created_at)VALUES(:t,:n,:type,1,NOW()) ON DUPLICATE KEY UPDATE active=1,type=VALUES(type)')->execute(['t'=>$t,'n'=>$name,'type'=>$type]);header('Location: /finance');exit;}
    public function openCash():void{$this->enabled();Authorization::require('finance.cash.manage');CSRF::enforce();$t=TenantContext::id();$amount=$this->money($_POST['opening_amount']??0)??0;$pdo=Database::connection();$q=$pdo->prepare("SELECT 1 FROM cash_sessions WHERE tenant_id=:t AND status='open' LIMIT 1");$q->execute(['t'=>$t]);if($q->fetchColumn())HttpException::abort(409,'Já existe um caixa aberto.');$pdo->prepare("INSERT INTO cash_sessions(tenant_id,opened_by,opening_amount,opened_at,status,notes)VALUES(:t,:u,:amount,NOW(),'open',:notes)")->execute(['t'=>$t,'u'=>Auth::user()['id'],'amount'=>$amount,'notes'=>trim((string)($_POST['notes']??''))?:null]);Audit::log('cash.open','cash_sessions',(int)$pdo->lastInsertId());header('Location: /finance');exit;}
    public function closeCash(string $id):void{$this->enabled();Authorization::require('finance.cash.manage');CSRF::enforce();$t=TenantContext::id();$closing=$this->money($_POST['closing_amount']??null);if($closing===null)HttpException::abort(422,'Informe o saldo contado.');$pdo=Database::connection();$q=$pdo->prepare("SELECT * FROM cash_sessions WHERE id=:id AND tenant_id=:t AND status='open' FOR UPDATE");$pdo->beginTransaction();try{$q->execute(['id'=>(int)$id,'t'=>$t]);$cash=$q->fetch();if(!$cash)throw new \DomainException('Caixa não encontrado.');$sum=$pdo->prepare("SELECT COALESCE(SUM(CASE WHEN type='income' AND status='paid' THEN amount WHEN type='expense' AND status='paid' THEN -amount ELSE 0 END),0) FROM financial_transactions WHERE tenant_id=:t AND created_at>=:opened AND (payment_method='dinheiro' OR payment_method IS NULL)");$sum->execute(['t'=>$t,'opened'=>$cash['opened_at']]);$expected=(float)$cash['opening_amount']+(float)$sum->fetchColumn();$pdo->prepare("UPDATE cash_sessions SET closing_amount=:closing,expected_amount=:expected,difference_amount=:diff,closed_by=:u,closed_at=NOW(),status='closed' WHERE id=:id AND tenant_id=:t")->execute(['closing'=>$closing,'expected'=>$expected,'diff'=>$closing-$expected,'u'=>Auth::user()['id'],'id'=>$cash['id'],'t'=>$t]);$pdo->commit();Audit::log('cash.close','cash_sessions',(int)$id,null,['expected'=>$expected,'closing'=>$closing]);}catch(\Throwable $e){if($pdo->inTransaction())$pdo->rollBack();HttpException::abort(422,$e->getMessage());}header('Location: /finance');exit;}
    private function grantMembershipCycle(\PDO $pdo,int $tenantId,int $membershipId,int $financialTransactionId,float $amount):void
    {
        $q=$pdo->prepare("SELECT cm.*,sp.validity_days FROM customer_memberships cm JOIN service_packages sp ON sp.id=cm.package_id AND sp.tenant_id=cm.tenant_id WHERE cm.id=:id AND cm.tenant_id=:t AND cm.status='active' FOR UPDATE");$q->execute(['id'=>$membershipId,'t'=>$tenantId]);$m=$q->fetch();if(!$m)throw new \DomainException('Mensalidade vinculada não está ativa.');
        $q=$pdo->prepare('SELECT id FROM customer_packages WHERE tenant_id=:t AND financial_transaction_id=:ft LIMIT 1');$q->execute(['t'=>$tenantId,'ft'=>$financialTransactionId]);if($q->fetchColumn())return;
        $expires=$m['validity_days']?date('Y-m-d H:i:s',strtotime('+'.(int)$m['validity_days'].' days')):($m['cycle']==='quarterly'?date('Y-m-d H:i:s',strtotime('+3 months')):date('Y-m-d H:i:s',strtotime('+1 month')));
        $pdo->prepare("INSERT INTO customer_packages(tenant_id,customer_id,package_id,purchased_at,expires_at,status,paid_amount,membership_id,financial_transaction_id,created_at)VALUES(:t,:c,:p,NOW(),:e,'active',:amount,:m,:ft,NOW())")->execute(['t'=>$tenantId,'c'=>$m['customer_id'],'p'=>$m['package_id'],'e'=>$expires,'amount'=>$amount,'m'=>$membershipId,'ft'=>$financialTransactionId]);
    }
    private function money(mixed $v):?float{$x=filter_var(str_replace(',','.',(string)$v),FILTER_VALIDATE_FLOAT);return $x===false||$x<0?null:(float)$x;}
    private function date(mixed $v):?string{$s=trim((string)$v);if($s==='')return null;if(!preg_match('/^\d{4}-\d{2}-\d{2}$/',$s))HttpException::abort(422,'Data inválida.');return $s;}
}
