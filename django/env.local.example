# SOMENTE PARA DESENVOLVIMENTO LOCAL.
# Gere DJANGO_SECRET_KEY e DJANGO_FIELD_ENCRYPTION_KEY antes de iniciar.
DJANGO_SECRET_KEY=replace-with-local-secret
DJANGO_FIELD_ENCRYPTION_KEY=replace-with-local-fernet-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=applanner
POSTGRES_USER=applanner
POSTGRES_PASSWORD=applanner-local-2026
DATABASE_URL=postgresql://applanner:applanner-local-2026@db:5432/applanner

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

TIME_ZONE=America/Recife
SECURE_SSL_REDIRECT=false
PUBLIC_BASE_URL=http://127.0.0.1:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=dev@localhost

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
META_PIXEL_ID=
META_CONVERSION_ACCESS_TOKEN=
META_GRAPH_BASE_URL=
WHATSAPP_GRAPH_BASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
