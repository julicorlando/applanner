<?php $editing=(bool)$plan;$features=$editing&&$plan['features_json']?json_decode($plan['features_json'],true):[];$includedFeatures=array_values(array_filter((array)($features['included_features']??($editing?[]:['Agendamento online 24 horas','Cadastro de clientes e serviços','Link público personalizado','Suporte pela plataforma'])),'is_string'));?>
<div class="section-heading"><div><div class="eyebrow">Produto</div><h1><?=$editing?'Editar plano':'Novo plano'?></h1><p class="text-secondary mb-0">Defina preços, período de teste, limites e módulos incluídos.</p></div><a class="btn btn-light" href="/master/plans">Voltar</a></div>
<div class="card"><div class="card-body"><form method="post" action="<?=$editing?'/master/plans/'.(int)$plan['id'].'/update':'/master/plans/store'?>"><?php echo \App\Core\CSRF::field();?>
<div class="row g-3">
<div class="col-md-5"><label class="form-label">Nome</label><input class="form-control" name="name" value="<?=htmlspecialchars($plan['name']??'')?>" required></div>
<div class="col-md-4"><label class="form-label">Identificador</label><input class="form-control" name="slug" value="<?=htmlspecialchars($plan['slug']??'')?>" placeholder="profissional"><div class="form-text">Usado internamente e na URL. Evite alterar depois de comercializar.</div></div>
<div class="col-md-3"><label class="form-label">Ordem de exibição</label><input class="form-control" type="number" name="sort_order" value="<?=htmlspecialchars((string)($plan['sort_order']??0))?>"></div>
<div class="col-12"><label class="form-label">Descrição comercial</label><textarea class="form-control" name="description" rows="2"><?=htmlspecialchars($plan['description']??'')?></textarea></div>
<div class="col-md-3"><label class="form-label">Mensal</label><div class="input-group"><span class="input-group-text">R$</span><input class="form-control" type="number" step=".01" min="0" name="monthly_price" value="<?=htmlspecialchars((string)($plan['monthly_price']??''))?>" required></div></div>
<div class="col-md-3"><label class="form-label">Trimestral</label><div class="input-group"><span class="input-group-text">R$</span><input class="form-control" type="number" step=".01" min="0" name="quarterly_price" value="<?=htmlspecialchars((string)($plan['quarterly_price']??''))?>"></div></div>
<div class="col-md-3"><label class="form-label">Semestral</label><div class="input-group"><span class="input-group-text">R$</span><input class="form-control" type="number" step=".01" min="0" name="semiannual_price" value="<?=htmlspecialchars((string)($plan['semiannual_price']??''))?>"></div></div>
<div class="col-md-3"><label class="form-label">Anual</label><div class="input-group"><span class="input-group-text">R$</span><input class="form-control" type="number" step=".01" min="0" name="annual_price" value="<?=htmlspecialchars((string)($plan['annual_price']??''))?>"></div></div>
<div class="col-md-3"><label class="form-label">Teste grátis</label><div class="input-group"><input class="form-control" type="number" min="0" max="90" name="trial_days" value="<?=htmlspecialchars((string)($plan['trial_days']??14))?>"><span class="input-group-text">dias</span></div></div>
<div class="col-md-3"><label class="form-label">Limite de profissionais</label><input class="form-control" type="number" min="1" name="professionals_limit" value="<?=htmlspecialchars((string)($features['professionals']??1))?>"></div>
<div class="col-md-3"><label class="form-label">Limite de unidades</label><input class="form-control" type="number" min="1" name="units_limit" value="<?=htmlspecialchars((string)($features['units']??1))?>"></div>
<div class="col-md-3 d-flex align-items-end"><label class="form-check"><input class="form-check-input" type="checkbox" name="active" value="1" <?=!$editing||$plan['active']?'checked':''?>> Plano ativo</label></div>
<div class="col-md-3 d-flex align-items-end"><label class="form-check"><input class="form-check-input" type="checkbox" name="featured" value="1" <?=($plan['featured']??0)?'checked':''?>> Destacar na página de planos</label></div>
<div class="col-12"><hr class="my-2"></div>
<div class="col-12"><div class="plan-feature-builder"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="h5 mb-1">Funcionalidades exibidas no plano</h2><p class="text-secondary mb-0">Escreva os benefícios que o cliente verá na página comercial. Arraste não é necessário: a ordem abaixo será a ordem exibida.</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-feature-add>+ Adicionar funcionalidade</button></div><div data-feature-list><?php foreach($includedFeatures as $item):?><div class="plan-feature-row"><span class="feature-check">✓</span><input class="form-control" name="included_features[]" maxlength="120" value="<?=htmlspecialchars($item,ENT_QUOTES,'UTF-8')?>" placeholder="Ex.: Lembretes automáticos"><button class="btn btn-light" type="button" data-feature-remove aria-label="Remover">×</button></div><?php endforeach;?></div><template data-feature-template><div class="plan-feature-row"><span class="feature-check">✓</span><input class="form-control" name="included_features[]" maxlength="120" placeholder="Ex.: Relatórios gerenciais"><button class="btn btn-light" type="button" data-feature-remove aria-label="Remover">×</button></div></template><small class="text-secondary">Até 30 itens, com 120 caracteres cada. Itens vazios não serão salvos.</small></div></div>
<div class="col-12"><hr class="my-2"></div>
<div class="col-12"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="h5 mb-1">Módulos incluídos no plano</h2><p class="text-secondary mb-0">Marque exatamente o que o cliente receberá. O que não estiver marcado fica fora do menu e bloqueado no servidor.</p></div><a class="btn btn-sm btn-outline-primary" href="/master/modulos">Gerenciar catálogo e preços avulsos</a></div></div>
<?php foreach($modules as $m):?><div class="col-md-6 col-xl-4"><label class="form-check border rounded p-3 h-100 module-plan-card"><input class="form-check-input" type="checkbox" name="modules[]" value="<?=(int)$m['id']?>" <?=in_array((int)$m['id'],$enabledModules,true)?'checked':''?>> <strong><?=htmlspecialchars($m['name'])?></strong><div class="small text-secondary mt-1"><?=htmlspecialchars($m['description']??'Sem descrição cadastrada.')?></div><?php if(!empty($m['addon_sellable'])&&(float)($m['addon_monthly_price']??0)>0):?><div class="small text-success mt-2">Também disponível avulso por R$ <?=number_format((float)$m['addon_monthly_price'],2,',','.')?>/mês</div><?php endif;?></label></div><?php endforeach;?>
<?php if(!$modules):?><div class="col-12"><div class="alert alert-warning">Nenhum módulo ativo no catálogo. Cadastre módulos antes de montar o plano.</div></div><?php endif;?>
</div><button class="btn btn-primary mt-4">Salvar plano</button></form></div></div>
<?php if($editing):?><div class="card mt-4 border-primary"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-3"><div><div class="eyebrow">Controle 100% pelo Master</div><h2 class="h5">Inteligência e canais deste plano</h2><p class="text-secondary">Essas permissões são aplicadas no servidor, inclusive nos disparos manuais.</p></div><span class="badge text-bg-primary">Premium</span></div><?php if(isset($_GET['automation_saved'])):?><div class="alert alert-success">Configuração de inteligência salva.</div><?php endif;?><form method="post" action="/master/plans/<?=(int)$plan['id']?>/automation"><?php echo \App\Core\CSRF::field();?><div class="row g-3"><div class="col-md-4"><label class="form-check border rounded p-3 h-100"><input class="form-check-input" type="checkbox" name="automation_return" value="1" <?=!empty($features['automation_return'])?'checked':''?>> <strong>Convites inteligentes</strong><div class="small text-secondary">Previsão de retorno com horários reais.</div></label></div><div class="col-md-4"><label class="form-check border rounded p-3 h-100"><input class="form-check-input" type="checkbox" name="automation_birthday" value="1" <?=!empty($features['automation_birthday'])?'checked':''?>> <strong>Aniversário premium</strong><div class="small text-secondary">Mensagem personalizada anual.</div></label></div><div class="col-md-4"><label class="form-check border rounded p-3 h-100"><input class="form-check-input" type="checkbox" name="automation_manual" value="1" <?=!empty($features['automation_manual'])?'checked':''?>> <strong>Disparo manual</strong><div class="small text-secondary">Inclui clientes deste plano no botão Master.</div></label></div><div class="col-md-3"><label class="form-check"><input class="form-check-input" type="checkbox" name="automation_email" value="1" <?=!empty($features['automation_email'])?'checked':''?>> E-mail</label></div><div class="col-md-3"><label class="form-check"><input class="form-check-input" type="checkbox" name="automation_whatsapp" value="1" <?=!empty($features['automation_whatsapp'])?'checked':''?>> WhatsApp</label></div><div class="col-md-3"><label class="form-label">Limite diário por empresa</label><input class="form-control" type="number" min="1" max="5000" name="automation_daily_limit" value="<?=htmlspecialchars((string)($features['automation_daily_limit']??50))?>"></div></div><button class="btn btn-primary mt-3">Salvar inteligência do plano</button></form></div></div><?php endif;?>
