<?php
namespace App\Controllers;
use App\Core\{Database,Encryption,RateLimiter,SecurityLogger};
use App\Services\NotificationService;
use App\Services\{PlatformSetting,WhatsAppChatbotService};
final class WebhookController
{
 public function whatsappVerify():void
 {
  $cfg=PlatformSetting::secret('platform.whatsapp');$mode=(string)($_GET['hub_mode']??$_GET['hub.mode']??'');$token=(string)($_GET['hub_verify_token']??$_GET['hub.verify_token']??'');$challenge=(string)($_GET['hub_challenge']??$_GET['hub.challenge']??'');if($mode==='subscribe'&&!empty($cfg['verify_token'])&&hash_equals((string)$cfg['verify_token'],$token)){header('Content-Type: text/plain');echo $challenge;return;}SecurityLogger::log('WHATSAPP_WEBHOOK_VERIFY_FAILED');http_response_code(403);
 }
 public function whatsapp():void
 {
  $ip=$_SERVER['REMOTE_ADDR']??'unknown';if(!RateLimiter::hit('webhook-whatsapp|'.$ip,600,60)){http_response_code(429);return;}$raw=file_get_contents('php://input')?:'';$cfg=PlatformSetting::secret('platform.whatsapp');$secret=(string)($cfg['app_secret']??'');$signature=preg_replace('/^sha256=/','',(string)($_SERVER['HTTP_X_HUB_SIGNATURE_256']??''));if($secret===''||$signature===''||!hash_equals(hash_hmac('sha256',$raw,$secret),$signature)){SecurityLogger::log('WHATSAPP_WEBHOOK_INVALID_SIGNATURE');http_response_code(401);return;}$data=json_decode($raw,true);if(!is_array($data)){http_response_code(400);return;}$service=new WhatsAppChatbotService();foreach($data['entry']??[] as $entry)foreach($entry['changes']??[] as $change){$value=$change['value']??[];foreach($value['messages']??[] as $message){$contact=$value['contacts'][0]??[];try{$service->receive($message,$contact,$value['metadata']??[]);}catch(\Throwable $e){error_log('[ApPlanner WhatsApp] '.mb_substr($e->getMessage(),0,300));}}foreach($value['statuses']??[] as $status){$id=(string)($status['id']??'');$state=(string)($status['status']??'');if($id&&in_array($state,['sent','delivered','read','failed'],true)){try{$q=Database::connection()->prepare('UPDATE whatsapp_messages SET status=:s,error_message=:e WHERE provider_message_id=:id');$q->execute(['s'=>$state,'e'=>$state==='failed'?json_encode($status['errors']??[]):null,'id'=>$id]);}catch(\Throwable){}}}}http_response_code(200);echo 'EVENT_RECEIVED';
 }
 public function mercadoPago():void
 {
  $ip=$_SERVER['REMOTE_ADDR']??'unknown';if(!RateLimiter::hit('webhook-mp|'.$ip,180,60)){http_response_code(429);return;}
  $pdo=Database::connection();$raw=file_get_contents('php://input')?:'';$data=json_decode($raw,true)?:[];$resource=(string)($_GET['data_id']??$_GET['data.id']??($data['data']['id']??''));$requestId=(string)($_SERVER['HTTP_X_REQUEST_ID']??'');$signature=(string)($_SERVER['HTTP_X_SIGNATURE']??'');if(!$resource){http_response_code(400);return;}
  $gateways=$pdo->query("SELECT * FROM payment_gateways WHERE provider='mercadopago' AND active=1 AND access_token_encrypted IS NOT NULL AND webhook_secret_encrypted IS NOT NULL ORDER BY (environment='production') DESC,last_tested_at DESC")->fetchAll();$gateway=null;$secret='';foreach($gateways as $candidate){try{$candidateSecret=Encryption::decrypt($candidate['webhook_secret_encrypted'])['value']??'';if(\App\Services\MercadoPagoProvider::validWebhookSignature($signature,$requestId,$resource,$candidateSecret)){$gateway=$candidate;$secret=$candidateSecret;break;}}catch(\Throwable){continue;}}
  if(!$gateway){SecurityLogger::log('WEBHOOK_INVALID',['provider'=>'mercadopago']);http_response_code(401);return;}
  $event=(string)($data['id']??($data['action']??'event').':'.$resource);try{$pdo->prepare("INSERT INTO provider_events(provider,event_id,event_type,payload_hash,status,received_at)VALUES('mercadopago',:id,:type,:hash,'received',NOW())")->execute(['id'=>$event,'type'=>(string)($data['type']??''),'hash'=>hash('sha256',$raw)]);}catch(\PDOException $e){if($e->getCode()==='23000'){http_response_code(204);return;}throw $e;}
  $token=Encryption::decrypt($gateway['access_token_encrypted'])['value']??'';
  try{
   $provider=new \App\Services\MercadoPagoProvider($token);$isOrder=(string)($data['type']??'')==='order'||str_starts_with((string)($data['action']??''),'order.');if($isOrder){$remote=$provider->getOrder($resource);$transaction=$remote['transactions']['payments'][0]??[];$amount=(float)($transaction['amount']??-1);$orderStatus=(string)($transaction['status']??$remote['status']??'unknown');$status=['processed'=>'approved','action_required'=>'pending','cancelled'=>'cancelled','refunded'=>'refunded','failed'=>'rejected'][$orderStatus]??$orderStatus;$external=trim((string)($remote['external_reference']??''));$providerPaymentId=(string)($transaction['id']??'');}else{$remote=$provider->getPayment($resource);$amount=(float)($remote['transaction_amount']??-1);$status=(string)($remote['status']??'unknown');$external=trim((string)($remote['external_reference']??''));$providerPaymentId=$resource;}
   $pdo->beginTransaction();
   $p=$pdo->prepare("SELECT p.id,p.tenant_id,p.amount,p.subscription_id,p.purpose,p.reference_id,p.idempotency_key,c.id checkout_id,c.plan_id,c.billing_cycle,c.total checkout_total FROM payments p LEFT JOIN checkout_sessions c ON p.purpose='subscription' AND c.tenant_id=p.tenant_id AND c.idempotency_key=p.idempotency_key WHERE p.provider='mercadopago' AND (p.provider_payment_id=:r OR p.provider_reference=:r2) LIMIT 1 FOR UPDATE");$p->execute(['r'=>$resource,'r2'=>$resource]);$payment=$p->fetch();
   if(!$payment&&$external!==''){
    if(str_starts_with($external,'MOD-')){$public=substr($external,4);$p=$pdo->prepare("SELECT p.id,p.tenant_id,p.amount,p.subscription_id,p.purpose,p.reference_id,p.idempotency_key,NULL checkout_id,NULL plan_id,NULL billing_cycle,NULL checkout_total FROM module_requests mr JOIN payments p ON p.tenant_id=mr.tenant_id AND p.purpose='module_addon' AND p.reference_id=mr.id AND p.provider='mercadopago' WHERE mr.public_id=:external LIMIT 1 FOR UPDATE");$p->execute(['external'=>$public]);$payment=$p->fetch();}
    else{$p=$pdo->prepare("SELECT p.id,p.tenant_id,p.amount,p.subscription_id,p.purpose,p.reference_id,p.idempotency_key,c.id checkout_id,c.plan_id,c.billing_cycle,c.total checkout_total FROM checkout_sessions c JOIN payments p ON p.tenant_id=c.tenant_id AND p.idempotency_key=c.idempotency_key AND p.provider='mercadopago' AND p.purpose='subscription' WHERE c.public_id=:external LIMIT 1 FOR UPDATE");$p->execute(['external'=>$external]);$payment=$p->fetch();}
   }
   if(!$payment||abs((float)$payment['amount']-$amount)>0.009){SecurityLogger::log('PAYMENT_AMOUNT_MISMATCH',['provider'=>'mercadopago','resource_hash'=>hash('sha256',$resource)]);throw new \DomainException('Pagamento não corresponde à cobrança interna.');}
   $internal=['approved'=>'paid','rejected'=>'failed','cancelled'=>'cancelled','refunded'=>'refunded','charged_back'=>'failed'][$status]??'pending';
   $pdo->prepare('UPDATE payments SET provider_payment_id=COALESCE(NULLIF(:resource,\'\'),provider_payment_id),status=:status,provider_status=:provider,environment=:env,paid_at=IF(:paid=\'paid\',NOW(),paid_at),updated_at=NOW() WHERE id=:id')->execute(['resource'=>$providerPaymentId,'status'=>$internal,'provider'=>$status,'env'=>$gateway['environment'],'paid'=>$internal,'id'=>$payment['id']]);$pixStatus=['paid'=>'paid','failed'=>'failed','cancelled'=>'cancelled','refunded'=>'cancelled'][$internal]??'pending';$pdo->prepare('UPDATE pix_charges SET provider_payment_id=COALESCE(NULLIF(:provider_payment,\'\'),provider_payment_id),status=:status,paid_at=IF(:paid=\'paid\',NOW(),paid_at),updated_at=NOW() WHERE payment_id=:payment')->execute(['provider_payment'=>$providerPaymentId,'status'=>$pixStatus,'paid'=>$internal,'payment'=>$payment['id']]);
   if(($payment['purpose']??'subscription')==='subscription'&&$internal==='paid'){$pdo->prepare("UPDATE commercial_commissions SET payment_id=:p,base_amount=:base,commission_amount=ROUND(:base2*commission_percent/100,2),status='approved',approved_at=COALESCE(approved_at,NOW()),reversed_at=NULL,updated_at=NOW() WHERE tenant_id=:t AND status='projected'")->execute(['p'=>$payment['id'],'base'=>$amount,'base2'=>$amount,'t'=>$payment['tenant_id']]);}
   if(($payment['purpose']??'subscription')==='subscription'&&in_array($internal,['refunded','cancelled','failed'],true)){$pdo->prepare("UPDATE commercial_commissions SET status='reversed',reversed_at=NOW(),updated_at=NOW() WHERE tenant_id=:t AND payment_id=:p AND status='approved'")->execute(['t'=>$payment['tenant_id'],'p'=>$payment['id']]);}
   if($internal==='paid'){
    if(($payment['purpose']??'subscription')==='module_addon'){
      $r=$pdo->prepare("SELECT mr.*,m.name module_name FROM module_requests mr JOIN modules m ON m.id=mr.module_id WHERE mr.id=:id AND mr.tenant_id=:t FOR UPDATE");$r->execute(['id'=>$payment['reference_id'],'t'=>$payment['tenant_id']]);$request=$r->fetch();if(!$request)throw new \DomainException('Solicitação do módulo não encontrada.');$next=(new \DateTimeImmutable('+1 month'))->format('Y-m-d H:i:s');$pdo->prepare("INSERT INTO tenant_module_addons(tenant_id,module_id,module_request_id,monthly_price,status,provider,provider_reference,started_at,next_billing_at,created_at,updated_at)VALUES(:t,:m,:r,:price,'active','mercadopago',:ref,NOW(),:next,NOW(),NOW()) ON DUPLICATE KEY UPDATE module_request_id=VALUES(module_request_id),monthly_price=VALUES(monthly_price),status='active',provider='mercadopago',provider_reference=VALUES(provider_reference),started_at=COALESCE(started_at,NOW()),next_billing_at=VALUES(next_billing_at),cancelled_at=NULL,updated_at=NOW()")->execute(['t'=>$payment['tenant_id'],'m'=>$request['module_id'],'r'=>$request['id'],'price'=>$request['quoted_monthly_price'],'ref'=>$request['provider_reference'],'next'=>$next]);$pdo->prepare('INSERT INTO tenant_modules(tenant_id,module_id,enabled)VALUES(:t,:m,1) ON DUPLICATE KEY UPDATE enabled=1')->execute(['t'=>$payment['tenant_id'],'m'=>$request['module_id']]);$pdo->prepare("UPDATE module_requests SET status='active',updated_at=NOW() WHERE id=:id")->execute(['id'=>$request['id']]);NotificationService::tenantOwners((int)$payment['tenant_id'],'module.addon.active','Módulo adicional ativado','O módulo '.$request['module_name'].' foi ativado após a confirmação do pagamento.','/billing/modulos','success');
    }else{
      if(empty($payment['checkout_id']))throw new \DomainException('Pagamento da assinatura sem sessão de contratação.');$months=['monthly'=>1,'quarterly'=>3,'semiannual'=>6,'annual'=>12][$payment['billing_cycle']]??1;$next=(new \DateTimeImmutable())->modify('+'.$months.' months')->format('Y-m-d H:i:s');
      $pdo->prepare("UPDATE invoices SET status='paid',paid_at=NOW(),updated_at=NOW() WHERE tenant_id=:t AND subscription_id=:s AND checkout_session_id=:c")->execute(['t'=>$payment['tenant_id'],'s'=>$payment['subscription_id'],'c'=>$payment['checkout_id']]);$pdo->prepare("UPDATE checkout_sessions SET status='paid',updated_at=NOW() WHERE id=:c AND tenant_id=:t")->execute(['c'=>$payment['checkout_id'],'t'=>$payment['tenant_id']]);$pdo->prepare("UPDATE subscriptions SET plan_id=:plan,billing_cycle=:cycle,contracted_price=:price,status='active',next_billing_at=:next,updated_at=NOW() WHERE id=:id AND tenant_id=:t")->execute(['plan'=>$payment['plan_id'],'cycle'=>$payment['billing_cycle'],'price'=>$payment['checkout_total'],'next'=>$next,'id'=>$payment['subscription_id'],'t'=>$payment['tenant_id']]);$pdo->prepare("UPDATE tenants SET status='active',updated_at=NOW() WHERE id=:t")->execute(['t'=>$payment['tenant_id']]);NotificationService::tenantOwners((int)$payment['tenant_id'],'billing.payment_paid','Pagamento confirmado','Seu pagamento foi confirmado e a assinatura está ativa.','/billing','success');
    }
   }elseif($internal==='failed'){
      if(($payment['purpose']??'subscription')==='module_addon'){$pdo->prepare("UPDATE module_requests SET status='payment_failed',updated_at=NOW() WHERE id=:id AND tenant_id=:t")->execute(['id'=>$payment['reference_id'],'t'=>$payment['tenant_id']]);NotificationService::tenantOwners((int)$payment['tenant_id'],'module.addon.failed','Pagamento do módulo não aprovado','Não foi possível confirmar o pagamento do módulo adicional. Você pode tentar novamente em Minha assinatura.','/billing/modulos','warning');}
      elseif(!empty($payment['checkout_id'])){$pdo->prepare("UPDATE checkout_sessions SET status='failed',updated_at=NOW() WHERE id=:c AND tenant_id=:t")->execute(['c'=>$payment['checkout_id'],'t'=>$payment['tenant_id']]);NotificationService::tenantOwners((int)$payment['tenant_id'],'billing.payment_failed','Pagamento não aprovado','Não foi possível confirmar o pagamento. Revise sua assinatura.','/billing','danger');}
   }
   $pdo->prepare("UPDATE provider_events SET status='processed',processed_at=NOW() WHERE provider='mercadopago' AND event_id=:id")->execute(['id'=>$event]);$pdo->commit();http_response_code(204);
  }catch(\Throwable $e){if($pdo->inTransaction())$pdo->rollBack();$pdo->prepare("UPDATE provider_events SET status='failed',error_message='processing_failed' WHERE provider='mercadopago' AND event_id=:id")->execute(['id'=>$event]);http_response_code($e instanceof \DomainException?422:500);}
 }
 public function payment(string $provider,string $tenant):void
 {
  $ip=$_SERVER['REMOTE_ADDR']??'unknown';if(!RateLimiter::hit('webhook|'.$ip,120,60)){http_response_code(429);return;}
  $raw=file_get_contents('php://input')?:'';$timestamp=(int)($_SERVER['HTTP_X_WEBHOOK_TIMESTAMP']??0);$event=(string)($_SERVER['HTTP_X_EVENT_ID']??'');$signature=(string)($_SERVER['HTTP_X_SIGNATURE']??'');
  if(abs(time()-$timestamp)>300||!preg_match('/^[A-Za-z0-9._-]{1,190}$/',$event)){SecurityLogger::log('webhook.rejected',['provider'=>$provider]);http_response_code(401);return;}
  $pdo=Database::connection();$q=$pdo->prepare("SELECT s.setting_value,t.id FROM tenants t JOIN settings s ON s.tenant_id=t.id AND s.setting_key='integration.payment' WHERE t.slug=:slug AND t.status IN('trial','active','suspended')");$q->execute(['slug'=>$tenant]);$config=$q->fetch();if(!$config){http_response_code(404);return;}
  $providerConfig=Encryption::decrypt($config['setting_value']);$secret=$providerConfig['webhook_secret']??'';if(($providerConfig['provider']??'')!==$provider){http_response_code(401);return;}$expected=hash_hmac('sha256',$timestamp.'.'.$raw,$secret);if(!$secret||!hash_equals($expected,preg_replace('/^sha256=/','',$signature))){SecurityLogger::log('webhook.invalid_signature',['provider'=>$provider,'tenant_id'=>$config['id']]);http_response_code(401);return;}
  $data=json_decode($raw,true);$reference=(string)($data['reference']??'');$paid=($data['event']??'')==='payment.paid';$pdo->beginTransaction();
  try{$pdo->prepare("INSERT INTO webhook_events(provider,event_id,signature_valid,payload_hash,status,received_at)VALUES(:provider,:event,1,:hash,'received',NOW())")->execute(['provider'=>$provider,'event'=>$event,'hash'=>hash('sha256',$raw)]);
   if($paid){$payment=$pdo->prepare("SELECT id,subscription_id,idempotency_key FROM payments WHERE tenant_id=:tenant AND provider=:provider AND provider_reference=:reference AND status='pending' LIMIT 1 FOR UPDATE");$payment->execute(['tenant'=>$config['id'],'provider'=>$provider,'reference'=>$reference]);$row=$payment->fetch();if($row){$checkout=$pdo->prepare('SELECT plan_id,billing_cycle,total FROM checkout_sessions WHERE idempotency_key=:key AND tenant_id=:tenant');$checkout->execute(['key'=>$row['idempotency_key'],'tenant'=>$config['id']]);$order=$checkout->fetch();if(!$order)throw new \RuntimeException('Checkout não encontrado.');$months=['monthly'=>1,'quarterly'=>3,'semiannual'=>6,'annual'=>12][$order['billing_cycle']];$next=(new \DateTimeImmutable())->modify('+'.$months.' months')->format('Y-m-d H:i:s');$pdo->prepare("UPDATE payments SET status='paid',paid_at=NOW(),updated_at=NOW() WHERE id=:id")->execute(['id'=>$row['id']]);$pdo->prepare("UPDATE invoices i JOIN checkout_sessions c ON c.id=i.checkout_session_id SET i.status='paid',i.paid_at=NOW(),i.updated_at=NOW(),c.status='paid',c.updated_at=NOW() WHERE c.idempotency_key=:key AND i.tenant_id=:tenant")->execute(['key'=>$row['idempotency_key'],'tenant'=>$config['id']]);$pdo->prepare("UPDATE subscriptions SET plan_id=:plan,billing_cycle=:cycle,contracted_price=:price,status='active',next_billing_at=:next,updated_at=NOW() WHERE id=:id AND tenant_id=:tenant")->execute(['plan'=>$order['plan_id'],'cycle'=>$order['billing_cycle'],'price'=>$order['total'],'next'=>$next,'id'=>$row['subscription_id'],'tenant'=>$config['id']]);$pdo->prepare("UPDATE tenants SET status='active',updated_at=NOW() WHERE id=:tenant")->execute(['tenant'=>$config['id']]);NotificationService::tenantOwners((int)$config['id'],'billing.payment_paid','Pagamento confirmado','Seu pagamento foi confirmado e a assinatura está ativa.','/billing','success');}}
   $pdo->prepare("UPDATE webhook_events SET status='processed',processed_at=NOW() WHERE provider=:provider AND event_id=:event")->execute(['provider'=>$provider,'event'=>$event]);$pdo->commit();http_response_code(204);
  }catch(\PDOException $e){if($pdo->inTransaction())$pdo->rollBack();if($e->getCode()==='23000'){http_response_code(204);return;}throw $e;}
 }
}
