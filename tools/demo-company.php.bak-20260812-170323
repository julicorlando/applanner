        }
        $customerData=[
            ['Mariana Alves',28,-39,0],['João Martins',15,-22,1],['Fernanda Costa',30,-28,0],['Carlos Oliveira',30,-93,1],['Paula Ribeiro',21,-18,2],['Renata Melo',45,-44,0],['Diego Santos',20,-20,1],['Larissa Nunes',35,-70,2]
        ];$customers=[];
