        insertRow($pdo,'subscriptions',['tenant_id'=>$tenant,'plan_id'=>$plan,'status'=>'active','started_at'=>date('Y-m-d H:i:s',strtotime('-60 days')),'next_billing_at'=>date('Y-m-d H:i:s',strtotime('+30 days')),'created_at'=>$now,'updated_at'=>$now]);
