<?php
namespace App\Services;
use App\Contracts\PaymentProviderInterface;
final class MercadoPagoProvider implements PaymentProviderInterface
{
 private string $token;private $transport;
 public function __construct(string $accessToken,?callable $transport=null){if(!preg_match('/^(APP_USR-|TEST-)[A-Za-z0-9_-]{10,}$/',$accessToken))throw new \InvalidArgumentException('Credencial Mercado Pago inválida.');$this->token=$accessToken;$this->transport=$transport;}
 public function createCustomer(array $customer):string{$r=$this->request('POST','/v1/customers',['email'=>$customer['email']??null]);return $this->requiredId($r);}
 public function createSubscription(array $subscription):array{$amount=round((float)($subscription['amount']??0),2);if(!is_finite($amount)||$amount<=0)throw new \InvalidArgumentException('O valor da assinatura deve ser maior que zero e possuir no máximo duas casas decimais.');$body=['reason'=>(string)$subscription['reason'],'external_reference'=>(string)$subscription['external_reference'],'payer_email'=>(string)$subscription['payer_email'],'back_url'=>(string)$subscription['back_url'],'status'=>'pending','auto_recurring'=>['frequency'=>(int)($subscription['frequency']??1),'frequency_type'=>'months','transaction_amount'=>$amount,'currency_id'=>'BRL']];if(!empty($subscription['trial_days']))$body['auto_recurring']['free_trial']=['frequency'=>(int)$subscription['trial_days'],'frequency_type'=>'days'];$r=$this->request('POST','/preapproval',$body,(string)($subscription['idempotency_key']??''));return ['reference'=>$this->requiredId($r),'status'=>(string)($r['status']??'pending'),'init_point'=>$r['init_point']??null];}
 public function createPayment(array $payment):array{throw new \LogicException('Cobrança SaaS recorrente deve usar createSubscription; dados de cartão não passam pelo servidor.');}
 public function cancelSubscription(string $reference):void{$this->request('PUT','/preapproval/'.rawurlencode($reference),['status'=>'cancelled']);}
 public function getPayment(string $reference):array{return $this->request('GET','/v1/payments/'.rawurlencode($reference));}
 public function handleWebhook(array $headers,string $payload):array{return json_decode($payload,true,512,JSON_THROW_ON_ERROR);}
 public function testConnection():array{return $this->request('GET','/users/me');}
 public static function validWebhookSignature(string $signature,string $requestId,string $dataId,string $secret,?int $now=null):bool{$parts=[];foreach(explode(',',$signature) as $part){[$k,$v]=array_pad(explode('=',trim($part),2),2,'');$parts[$k]=$v;}$ts=(int)($parts['ts']??0);$now??=time();if(!$secret||!$requestId||!$dataId||!$ts||abs($now-(int)floor($ts/($ts>9999999999?1000:1)))>300)return false;$manifest='id:'.strtolower($dataId).';request-id:'.$requestId.';ts:'.$parts['ts'].';';return isset($parts['v1'])&&hash_equals(hash_hmac('sha256',$manifest,$secret),$parts['v1']);}
 private function request(string $method,string $path,array $body=[],string $idempotency=''):array{if($this->transport)return ($this->transport)($method,$path,$body,$idempotency,$this->token);if(!function_exists('curl_init'))throw new \RuntimeException('Extensão cURL obrigatória para Mercado Pago.');$ch=curl_init('https://api.mercadopago.com'.$path);$headers=['Authorization: Bearer '.$this->token,'Content-Type: application/json'];if($idempotency!=='')$headers[]='X-Idempotency-Key: '.$idempotency;curl_setopt_array($ch,[CURLOPT_RETURNTRANSFER=>true,CURLOPT_CUSTOMREQUEST=>$method,CURLOPT_HTTPHEADER=>$headers,CURLOPT_TIMEOUT=>20,CURLOPT_CONNECTTIMEOUT=>5]);if($method!=='GET')curl_setopt($ch,CURLOPT_POSTFIELDS,json_encode($body,JSON_THROW_ON_ERROR));$raw=curl_exec($ch);$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);$curlError=$raw===false?curl_error($ch):'';curl_close($ch);if($raw===false)throw new \RuntimeException('Mercado Pago indisponível: '.($curlError!==''?$curlError:'falha de conexão').'.');$decoded=json_decode($raw,true);if($status<200||$status>=300){$message=is_array($decoded)?(string)($decoded['message']??$decoded['error']??'requisição recusada'):'requisição recusada';$cause='';if(is_array($decoded)&&isset($decoded['cause'][0])&&is_array($decoded['cause'][0]))$cause=(string)($decoded['cause'][0]['code']??$decoded['cause'][0]['description']??'');$safe=preg_replace('/[^\pL\pN _.,:;@()\/-]/u','',trim($message));$safeCause=preg_replace('/[^\pL\pN _.,:;@()\/-]/u','',trim($cause));throw new \RuntimeException('Mercado Pago HTTP '.$status.': '.mb_substr($safe?:'requisição recusada',0,180).($safeCause!==''?' ['.mb_substr($safeCause,0,80).']':''));}if(!is_array($decoded))throw new \RuntimeException('Resposta inválida do Mercado Pago.');return $decoded;}
 private function requiredId(array $r):string{$id=(string)($r['id']??'');if($id==='')throw new \RuntimeException('Resposta inválida do provider.');return $id;}
}
